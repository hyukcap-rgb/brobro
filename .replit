modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
# NOTE: kept as a single always-on instance (not "autoscale").
# The API server keeps job state and downloaded attachments in memory /
# on local disk (artifacts/api-server/src/lib/bid-processing.ts). Autoscale
# runs multiple separate instances with separate local disks, so a job
# started on one instance would randomly 404 ("작업을 찾을 수 없습니다")
# when a status check or download lands on a different instance.
# Reserved VM keeps one instance running, which this app's storage model
# requires until job state is moved to Postgres/object storage.
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
